{
  "Version": "1.0",
  "Description": "Removes the AI features Microsoft has added to Windows and its built-in apps.",
  "Deployment": [
    {
      "Name": "CreateRestorePoint",
      "Value": true
    },
    {
      "Name": "SkipRegistryBackup",
      "Value": false
    }
  ],
  "Tweaks": [
    {
      "Name": "DisableCopilot",
      "Value": true
    },
    {
      "Name": "DisableRecall",
      "Value": true
    },
    {
      "Name": "DisableClickToDo",
      "Value": true
    },
    {
      "Name": "DisableAISvcAutoStart",
      "Value": true
    },
    {
      "Name": "DisablePaintAI",
      "Value": true
    },
    {
      "Name": "DisableNotepadAI",
      "Value": true
    },
    {
      "Name": "DisableEdgeAI",
      "Value": true
    },
    {
      "Name": "DisableBing",
      "Value": true
    }
  ]
}
